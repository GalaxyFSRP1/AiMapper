# Copy to .env and fill in — never commit real secrets.
# The server reads plain environment variables; use your host's secret store in production.

PORT=8080
HOST=0.0.0.0

# ---- GitHub OAuth App (https://github.com/settings/developers) ----
# Homepage URL:      https://your-deployment
# Authorization callback URL: https://your-deployment/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- optional ----
MAPPER_DATA_DIR=.data
MAPPER_ENCRYPTION_KEY=
MAPPER_DEFAULT_OWNER=GalaxyFSRP1
MAPPER_DEFAULT_REPO=AiMapper
MAPPER_DEFAULT_BASE_PATH=models
# MAPPER_DISABLE_MANUAL_TOKEN=1
# MAPPER_DISABLE_SANDBOX=1
# MAPPER_TRUST_PROXY=1
# MAPPER_ALLOWED_ORIGINS=https://example.com
