{
  "name": "aimapper-model-studio",
  "version": "2.0.0",
  "private": true,
  "description": "AiMapper \u2014 BeatForge auto-mapper plus Model Studio: an automated ~5M parameter model generator with GitHub publishing",
  "main": "app/backend/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node app/backend/server.js",
    "dev": "MAPPER_ACCESS_LOG=0 node app/backend/server.js",
    "test": "node scripts/verify.js",
    "test:pipeline": "node tests/pipeline.test.js",
    "test:api": "node tests/api.test.js",
    "test:github": "node tests/github.test.js",
    "test:ui": "node tests/ui.test.js",
    "test:train": "node tests/train.test.js",
    "test:live": "node tests/github.test.js --live",
    "build:example": "node scripts/generate-artifact.js --out dist/model",
    "pack": "node scripts/pack.js",
    "verify": "node scripts/verify.js --zip",
    "docker:build": "docker build -t aimapper .",
    "docker:run": "docker run --rm -p 8080:8080 aimapper"
  },
  "keywords": [
    "mapper",
    "beat-saber",
    "transformer",
    "github",
    "model-generation"
  ],
  "license": "MIT"
}
